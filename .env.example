# Copie este arquivo para .env e ajuste os valores.
# Nunca envie o arquivo .env para o repositório.

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco: sqlite (padrão, para desenvolvimento) ou postgres
DB_ENGINE=sqlite
